# TerraShield local server settings — easiest: run `npm run setup` (it writes .env for you).
# .env is private: never commit it or put it in a ZIP.
PORT=8080
# 127.0.0.1 = reachable from this laptop only (recommended).
HOST=127.0.0.1
# Admin records are stored here (base fictional data in shared/ is never changed).
DB_FILE=data/db.json

# Admin login. `npm run setup` writes these two lines (only a scrypt hash of the password is stored):
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
# Alternative (less safe — plain text): leave ADMIN_PASSWORD_HASH empty and set
# ADMIN_PASSWORD=at-least-10-characters
